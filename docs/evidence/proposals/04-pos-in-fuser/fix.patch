diff --git a/packages/rppg-web/src/__tests__/fusionChromGolden.test.ts b/packages/rppg-web/src/__tests__/fusionChromGolden.test.ts
new file mode 100644
index 0000000..3c58ab0
--- /dev/null
+++ b/packages/rppg-web/src/__tests__/fusionChromGolden.test.ts
@@ -0,0 +1,67 @@
+import { MultiRoiRppgFuser, type FusionRoiName } from '../multiRoiFusion';
+
+// fusionProjection "chrom" is kept so that the fuser's previous output stays reachable. This pins it:
+// the summary below was produced by the fuser on Elata main 49fdb41 (and by the published 0.14.0
+// dist) for exactly this input, which has a region dropping out, a region below the skin threshold
+// and a reset part way through. If any of it moves, "chrom" no longer reproduces the old fuser.
+
+function runStream(fuser: MultiRoiRppgFuser) {
+  let s = 12345;
+  const noise = () => {
+    let t = 0;
+    for (let k = 0; k < 4; k++) { s = (s * 1664525 + 1013904223) >>> 0; t += s / 4294967296; }
+    return (t - 2) * 1.5;
+  };
+  const sum = { valid: 0, fused: 0, fused2: 0, fusedOrder: 0, fusedSnr: 0, foreheadWeight: 0, cheekSnr: 0 };
+  for (let i = 0; i < 900; i++) {
+    if (i === 500) fuser.reset();
+    const p = 0.004 * Math.sin((2 * Math.PI * 1.2 * i) / 30);
+    const region = (skin: number) => ({ r: 180 * (1 + 0.33 * p) + noise(), g: 120 * (1 + 0.77 * p) + noise(), b: 100 * (1 + 0.53 * p) + noise(), skinFraction: skin });
+    const frame: Partial<Record<FusionRoiName, ReturnType<typeof region>>> = {
+      forehead: region(0.9),
+      leftCheek: i % 97 < 20 ? undefined : region(0.8),
+      rightCheek: region(i % 61 < 15 ? 0.05 : 0.7),
+    };
+    const out = fuser.pushFrame(frame);
+    if (!out.valid) continue;
+    sum.valid += 1;
+    sum.fused += out.fused;
+    sum.fused2 += out.fused * out.fused;
+    sum.fusedOrder += out.fused * ((i % 13) - 6);
+    sum.fusedSnr += out.fusedSnr;
+    sum.foreheadWeight += out.weights.forehead;
+    sum.cheekSnr += out.snr.leftCheek + out.snr.rightCheek;
+  }
+  return sum;
+}
+
+// Printed with toPrecision(17) from 49fdb41's dist/multiRoiFusion.js.
+const MAIN_49FDB41 = {
+  valid: 900,
+  fused: -1.8361663750866783,
+  fused2: 2.8756434728875888,
+  fusedOrder: 4.0572133439041371,
+  fusedSnr: 2846.7296577304264,
+  foreheadWeight: 315.29913304827431,
+  cheekSnr: 7034.6825814065014,
+};
+
+function expectSame(actual: Record<string, number>, expected: Record<string, number>) {
+  for (const [key, want] of Object.entries(expected)) {
+    // Relative 1e-9: far tighter than any change to the projection could stay inside, loose
+    // enough that a different libm rounding of Math.sin in another Node version does not trip it.
+    const tol = Math.max(1e-12, Math.abs(want) * 1e-9);
+    expect({ key, diff: Math.abs(actual[key] - want) <= tol, actual: actual[key] }).toEqual({ key, diff: true, actual: actual[key] });
+  }
+}
+
+describe('fusionProjection "chrom"', () => {
+  test('reproduces the fuser on Elata main 49fdb41', () => {
+    expectSame(runStream(new MultiRoiRppgFuser(30, undefined, undefined, 'chrom')), MAIN_49FDB41);
+  });
+
+  test('the default projection is not the old fuser, so the check above can fail', () => {
+    const pos = runStream(new MultiRoiRppgFuser(30));
+    expect(Math.abs(pos.fused - MAIN_49FDB41.fused)).toBeGreaterThan(1e-3);
+  });
+});
diff --git a/packages/rppg-web/src/__tests__/posPulseModel.test.ts b/packages/rppg-web/src/__tests__/posPulseModel.test.ts
new file mode 100644
index 0000000..0b08653
--- /dev/null
+++ b/packages/rppg-web/src/__tests__/posPulseModel.test.ts
@@ -0,0 +1,143 @@
+import { MultiRoiRppgFuser, type RoiRgbSample } from "../multiRoiFusion";
+import { ChromPulseModel, PosPulseModel } from "../rppgSignalModel";
+
+// POS (Wang, den Brinker, Stuijk and de Haan, IEEE TBME 2017): on window-mean-normalised
+// channels, S1 = G - B and S2 = G + B - 2R, h = S1 + (sd S1 / sd S2) S2. Each normalised
+// channel averages exactly 1 over the window, so each axis averages the sum of its
+// weights: 0 for both POS axes, 1 for both CHROM axes (3R - 2G and 1.5R + G - 1.5B).
+// The pulse is a colour change along the blood-volume direction, about (0.33, 0.77, 0.53)
+// of each channel (de Haan and van Leest 2014).
+
+const fs = 30;
+const corr = (a: number[], b: number[]) => {
+	const n = a.length;
+	const ma = a.reduce((x, y) => x + y, 0) / n;
+	const mb = b.reduce((x, y) => x + y, 0) / n;
+	let sab = 0;
+	let saa = 0;
+	let sbb = 0;
+	for (let i = 0; i < n; i++) {
+		sab += (a[i]! - ma) * (b[i]! - mb);
+		saa += (a[i]! - ma) ** 2;
+		sbb += (b[i]! - mb) ** 2;
+	}
+	return sab / Math.sqrt(saa * sbb);
+};
+const sd = (a: number[]) => {
+	const m = a.reduce((x, y) => x + y, 0) / a.length;
+	return Math.sqrt(a.reduce((x, y) => x + (y - m) ** 2, 0) / a.length);
+};
+function rng(seed: number) {
+	let s = seed >>> 0;
+	return () => {
+		s = (s * 1664525 + 1013904223) >>> 0;
+		return s / 0xffffffff;
+	};
+}
+function gauss(r: () => number) {
+	let u = 0;
+	while (u === 0) u = r();
+	return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * r());
+}
+
+describe("PosPulseModel", () => {
+	test("a brightness change alone gives no output (CHROM shares this property)", () => {
+		const m = new PosPulseModel();
+		const out: number[] = [];
+		for (let i = 0; i < 300; i++) {
+			const k = 1 + 0.05 * Math.sin((2 * Math.PI * 0.8 * i) / fs);
+			out.push(m.process(180 * k, 120 * k, 100 * k));
+		}
+		for (const v of out.slice(20)) expect(Math.abs(v)).toBeLessThan(1e-9);
+	});
+
+	test.each([1, 2, 3])(
+		"under sensor noise alone the output stays at the scale of the noise (seed %i)",
+		(seed) => {
+			// Noise of 0.1 level per channel is at most 0.1 / 100 = 0.001 of a channel's
+			// level. S1 and S2 average zero, so the per-frame weight only scales noise-sized
+			// deviations. With CHROM's arithmetic the output carries (1 - weight), and the
+			// weight's wobble makes it roughly a hundred times larger.
+			const m = new PosPulseModel();
+			const r = rng(seed);
+			const out: number[] = [];
+			for (let i = 0; i < 300; i++) {
+				out.push(
+					m.process(
+						180 + 0.1 * gauss(r),
+						120 + 0.1 * gauss(r),
+						100 + 0.1 * gauss(r),
+					),
+				);
+			}
+			expect(sd(out.slice(45))).toBeLessThan(5 * 0.001);
+		},
+	);
+
+	test("recovers a blood-volume pulse under a brightness swing ten times its size", () => {
+		const m = new PosPulseModel();
+		const out: number[] = [];
+		const pulse: number[] = [];
+		for (let i = 0; i < 300; i++) {
