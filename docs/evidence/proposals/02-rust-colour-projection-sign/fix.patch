@@ -150,6 +150,10 @@ impl RppgPipeline {
         self.tracker = None;
     }
 
+    /// Push one pre-extracted value, such as a fused pulse or a green-only intensity. It is
+    /// stored with R = G = B, and an analysis window made only of such samples is not
+    /// colour-separated (there is no colour difference to separate): it is projected as it was
+    /// before the CHROM sign fix, so readings from such samples did not change.
     pub fn push_sample(&mut self, timestamp_ms: i64, intensity: f32) {
         // Backwards-compatible: green-only intensity.
         self.push_sample_rgb(timestamp_ms, intensity, intensity, intensity, 1.0);
@@ -209,6 +213,8 @@ impl RppgPipeline {
     }
 
     /// Compute rPPG metrics over the current window.
+    /// - Projects RGB to a pulse signal with CHROM over 1.6 s windows (a window of
+    ///   [`push_sample`](Self::push_sample) values, R = G = B, keeps the pre-fix projection)
     /// - Applies temporal normalization
     /// - Runs bandpass filter
     /// - Computes a simple periodogram over candidate HR band and returns peak BPM
@@ -471,6 +477,8 @@ fn resample_rgb_into(
     r_out.len() >= 10
 }
 
+/// Colour projection with CHROM's axes (de Haan & Jeanne 2013): X = 3R - 2G and
+/// Y = 1.5R + G - 1.5B on window-normalised channels, combined as S = X - (sd X / sd Y) * Y.
 #[allow(clippy::too_many_arguments)]
 fn pos_from_rgb_windowed_into(
     r: &[f32],
@@ -522,8 +530,26 @@ fn pos_from_rgb_windowed_into(
         let std_x = stddev(x_buf);
         let std_y = stddev(y_buf);
         let alpha = if std_y > 1e-6 { std_x / std_y } else { 0.0 };
+        // A window with no colour difference in it (every sample R = G = B, as push_sample sends
+        // one value, for example the multi-region fuser's pulse) has nothing for a colour
+        // projection to separate: X = Y there, so X - alpha * Y would cancel it. Such a window
+        // keeps the expression it had before the sign fix, X + alpha * Y: that is 2X up to
+        // rounding (the normalised value itself, scaled, as the GREEN method would use it), and
+        // keeping it rather than X leaves readings from these samples bit for bit unchanged.
+        // A window with any camera colour in it goes through CHROM whole, which also cancels the
+        // jump where camera RGB meets pre-extracted values: normalisation makes it equal on R, G
+        // and B, which is brightness. Decided per sample instead, that jump stays in the signal.
+        let pre_extracted = r_win
+            .iter()
+            .zip(g_win)
+            .zip(b_win)
+            .all(|((rv, gv), bv)| rv == gv && gv == bv);
         for i in 0..win_len {
-            out[start + i] += x_buf[i] + alpha * y_buf[i];
+            out[start + i] += if pre_extracted {
+                x_buf[i] + alpha * y_buf[i]
+            } else {
+                x_buf[i] - alpha * y_buf[i]
+            };
             w_buf[start + i] += 1.0;
         }
         start += step;
@@ -577,6 +603,185 @@ mod tests {
     use super::*;
     use std::f32::consts::PI;
 
+    /// RMS of the colour projection for 10 s of input at 30 Hz.
+    fn projection_rms(rgb: impl Fn(f32) -> (f32, f32, f32)) -> f32 {
+        let n = 300;
+        let (mut r, mut g, mut b) = (vec![], vec![], vec![]);
+        for i in 0..n {
+            let (ri, gi, bi) = rgb(i as f32 / 30.0);
+            r.push(ri);
+            g.push(gi);
+            b.push(bi);
+        }
+        let (mut out, mut x, mut y, mut w) = (vec![], vec![], vec![], vec![]);
+        assert!(pos_from_rgb_windowed_into(
+            &r, &g, &b, &mut out, &mut x, &mut y, &mut w, 30.0, 1.6
+        ));
+        (out.iter().map(|v| v * v).sum::<f32>() / n as f32).sqrt()
+    }
+
+    /// CHROM (de Haan & Jeanne 2013) is S = X - (sd X / sd Y) * Y. A lamp scales R, G and B alike,
+    /// so after normalisation it moves X and Y by the same amount and the subtraction cancels it
+    /// (adding doubled it). A blood-volume pulse moves X and Y in opposite directions, so the
+    /// subtraction keeps it (adding cancelled it).
+    #[test]
+    fn projection_cancels_brightness_and_keeps_pulse_colour() {
+        let lamp = projection_rms(|t| {
+            let k = 1.0 + 0.01 * (2.0 * PI * 1.2 * t).sin();
+            (150.0 * k, 120.0 * k, 100.0 * k)
+        });
+        let pulse = projection_rms(|t| {
+            let p = (2.0 * PI * 1.2 * t).sin();
+            (
+                150.0 * (1.0 - 0.001 * p),
+                120.0 * (1.0 - 0.003 * p),
+                100.0 * (1.0 - 0.0018 * p),
+            )
+        });
+        assert!(
+            lamp < 0.1 * pulse,
+            "lamp {lamp} should cancel, pulse {pulse}"
+        );
+    }
+
+    /// A window of push_sample values (R = G = B) is projected exactly as before the sign fix,
+    /// X + (sd X / sd Y) * Y, so readings made only from such samples (the default fused path)
+    /// stay bit for bit what they were. X = Y there only up to rounding, so X alone, although
+    /// equal to half of it in exact arithmetic, moved near-tied readings downstream.
+    #[test]
+    fn pre_extracted_window_is_projected_as_before() {
+        let fs = 30.0_f32;
+        let n = (1.6 * fs).round() as usize; // exactly one analysis window
+        let v: Vec<f32> = (0..n)
+            .map(|i| 100.0 + (2.0 * PI * 1.5 * i as f32 / fs).sin())
+            .collect();
+        let (mut out, mut x, mut y, mut w) = (vec![], vec![], vec![], vec![]);
+        assert!(pos_from_rgb_windowed_into(
+            &v, &v, &v, &mut out, &mut x, &mut y, &mut w, fs, 1.6
+        ));
+        assert_eq!((out.len(), x.len()), (n, n));
+        let alpha = stddev(&x) / stddev(&y);
+        for i in 0..n {
+            let before = x[i] + alpha * y[i];
+            assert_eq!(
+                out[i].to_bits(),
+                before.to_bits(),
+                "sample {i}: {} against {before}",
+                out[i]
+            );
+        }
+    }
+
+    /// The fused path (push_sample, R = G = B) must read a pulse at its rate as before, alone and
+    /// after a stretch of camera RGB inside the analysed window (DemoRunner sends camera RGB on
+    /// frames the fuser cannot use, for example before it has face regions): the window covers
+    /// the last 10 of 14 s, so RGB until 7 s puts 3 s of it in.
+    #[test]
+    fn fused_samples_keep_their_rate() {
+        let fs = 30.0_f32;
+        // 72, 90, 110 and 140 are rates the fused path, including its per-window normalisation,
+        // reads within 5 bpm, before this change and after it. Not every rate between them does,
+        // on either (74 reads 48.6, 114 reads 106.8). With RGB in the window, 140 reads as none
+        // before this change too, so that case is left out rather than pinned.
+        let cases: [(f32, &[f32]); 4] = [
+            (72.0, &[0.0, 7.0]),
+            (90.0, &[0.0, 7.0]),
+            (110.0, &[0.0, 7.0]),
+            (140.0, &[0.0]),
+        ];
+        for &(bpm, firsts) in &cases {
+            for &rgb_first_s in firsts {
+                let mut p = RppgPipeline::new(fs, 10.0);
+                for i in 0..(14.0 * fs) as usize {
+                    let t = i as f32 / fs;
+                    let v = (2.0 * PI * bpm / 60.0 * t).sin();
+                    let ts = (t * 1000.0) as i64;
+                    if t < rgb_first_s {
+                        p.push_sample_rgb(
+                            ts,
+                            150.0 * (1.0 - 0.001 * v),
+                            120.0 * (1.0 - 0.003 * v),
+                            100.0 * (1.0 - 0.0018 * v),
+                            1.0,
+                        );
+                    } else {
+                        p.push_sample(ts, v);
+                    }
+                }
+                let got = p.get_metrics().bpm;
+                assert!(
+                    got.is_some_and(|b| (b - bpm).abs() <= 5.0),
+                    "true {bpm} (RGB first {rgb_first_s} s) read {got:?}"
+                );
+            }
+        }
+    }
+
+    /// Known answer through the public API: a 90 bpm pulse under a lamp flickering by 1% at 60 or
+    /// 120 a minute. The projection must follow the pulse, not the lamp. Pulse colour from the
+    /// blood-volume-pulse signature, roughly 0.33 : 0.77 : 0.53 in R : G : B (de Haan & van Leest
+    /// 2014), at 0.4% in green.
+    #[test]
+    fn rgb_input_reads_the_pulse_not_the_lamp() {
+        let fs = 30.0_f32;
+        for &lamp_bpm in &[60.0_f32, 120.0] {
+            let mut p = RppgPipeline::new(fs, 10.0);
+            for i in 0..(12.0 * fs) as usize {
+                let t = i as f32 / fs;
+                let pulse = (2.0 * PI * 1.5 * t).sin();
+                let lamp = 1.0 + 0.01 * (2.0 * PI * lamp_bpm / 60.0 * t + 0.7).sin();
+                let a = 0.004 / 0.77;
+                p.push_sample_rgb(
+                    (t * 1000.0) as i64,
+                    150.0 * lamp * (1.0 - 0.33 * a * pulse),
+                    120.0 * lamp * (1.0 - 0.77 * a * pulse),
+                    100.0 * lamp * (1.0 - 0.53 * a * pulse),
+                    1.0,
+                );
+            }
+            let got = p.get_metrics().bpm;
+            assert!(
+                got.is_some_and(|b| (b - 90.0).abs() <= 3.0),
+                "lamp {lamp_bpm}: read {got:?}, true pulse 90"
+            );
+        }
+    }
+
+    /// A window that holds camera RGB and then the first fused samples (the moment DemoRunner
+    /// switches to the fuser) must still read the pulse. Per-window normalisation turns the jump
+    /// from camera-scale values to the fuser's zero-mean values into an equal drop on R, G and B,
+    /// which is brightness, so CHROM cancels it when the whole mixed window goes through CHROM.
+    #[test]
+    fn switch_from_camera_rgb_to_fused_reads_the_pulse() {
+        let fs = 30.0_f32;
+        for &bpm in &[66.0_f32, 90.0, 120.0] {
+            let mut p = RppgPipeline::new(fs, 10.0);
+            // 14 s with a 10 s window: camera RGB for the first 9 s of the window, fused for 1 s.
+            for i in 0..(14.0 * fs) as usize {
+                let t = i as f32 / fs;
+                let v = (2.0 * PI * bpm / 60.0 * t).sin();
+                let ts = (t * 1000.0) as i64;
+                if t < 13.0 {
+                    let a = 0.004 / 0.77;
+                    p.push_sample_rgb(
+                        ts,
+                        150.0 * (1.0 - 0.33 * a * v),
+                        120.0 * (1.0 - 0.77 * a * v),
+                        100.0 * (1.0 - 0.53 * a * v),
+                        1.0,
+                    );
+                } else {
+                    p.push_sample(ts, v);
+                }
+            }
+            let got = p.get_metrics().bpm;
+            assert!(
+                got.is_some_and(|b| (b - bpm).abs() <= 3.0),
+                "true {bpm}: read {got:?} across the switch to fused samples"
+            );
+        }
+    }
+
     #[test]
     fn mean_over_window() {
         let mut p = RppgPipeline::new(30.0, 2.0);
