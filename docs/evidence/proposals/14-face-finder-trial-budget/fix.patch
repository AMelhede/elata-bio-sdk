From 29ac9b4d9e3f81a9c6b24e02a299872cd9ba6c10 Mon Sep 17 00:00:00 2001
From: Andreas Melhede <95473109+AMelhede@users.noreply.github.com>
Date: Wed, 14 Oct 2026 20:03:14 +0000
Subject: [PATCH] fix(rppg-web): a face finder trial candidate stops once its
 calls pass a 2 s budget

With faceMesh "auto" and fixes.faceFinderTrial on, each delegate is timed
for 13 calls on the live video before the faster is kept. On a heavily
throttled device a software GPU can take seconds a call, so the trial spent
tens of seconds on a candidate that could never win, and the face was
analysed at well under one frame a second for the whole reading.

A candidate's trial now also ends once its calls after the first (shader
compile and WASM warm-up excluded) total 2 s; its mean so far is its
result. A candidate up to about 150 ms a call is still timed for every
call, so only one too slow to be kept is cut short. The winner on the
existing 290 ms GPU against 60 ms CPU case is unchanged; the GPU is now
cut after 8 calls instead of 13.
---
 .changeset/face-finder-trial-budget.md        |  5 +++
 .../src/__tests__/faceFinderTrial.test.ts     | 35 +++++++++++++++++--
 packages/rppg-web/src/faceFinderTrial.ts      | 29 ++++++++++++---
 3 files changed, 62 insertions(+), 7 deletions(-)
 create mode 100644 .changeset/face-finder-trial-budget.md

diff --git a/.changeset/face-finder-trial-budget.md b/.changeset/face-finder-trial-budget.md
new file mode 100644
index 0000000..9ca7e45
--- /dev/null
+++ b/.changeset/face-finder-trial-budget.md
@@ -0,0 +1,5 @@
+---
+"@elata-biosciences/rppg-web": patch
+---
+
+Trial face finder time budget: a candidate's trial also ends once its calls after the first have taken 2 s in total, and its mean so far is its result. On a heavily throttled device the software GPU took about 3.3 s a call, so the 13-call trial spent about 43 s on it before trying the CPU and the face was analysed at about 0.3 frames a second for a whole reading, against about 4 with the trial switched off. A fast candidate is still timed for all of its calls.
diff --git a/packages/rppg-web/src/__tests__/faceFinderTrial.test.ts b/packages/rppg-web/src/__tests__/faceFinderTrial.test.ts
index 42ea2ad..f20682d 100644
--- a/packages/rppg-web/src/__tests__/faceFinderTrial.test.ts
+++ b/packages/rppg-web/src/__tests__/faceFinderTrial.test.ts
@@ -1,5 +1,6 @@
 import {
 	FINDER_SWITCH_MARGIN,
+	FINDER_TRIAL_BUDGET_MS,
 	FINDER_TRIAL_TIMED_CALLS,
 	FINDER_TRIAL_WARMUP_CALLS,
 	type FinderCandidate,
@@ -79,8 +80,10 @@ describe("the trial on the live video", () => {
 		const gpu = fake("GPU", 290, clock);
 		const cpu = fake("CPU", 60, clock);
 		const f = new TrialFaceFinder([gpu, cpu], { now: () => clock.t });
-		drive(f, PER, clock);
-		expect(gpu.calls).toHaveLength(PER);
+		// 290 ms a call passes the trial's time budget before its 13 calls: it is cut short there.
+		const gpuCalls = 1 + Math.ceil(FINDER_TRIAL_BUDGET_MS / 290);
+		drive(f, gpuCalls, clock);
+		expect(gpu.calls).toHaveLength(gpuCalls);
 		expect(cpu.calls).toHaveLength(0);
 		drive(f, PER, clock);
 		expect(cpu.calls).toHaveLength(PER);
@@ -89,7 +92,7 @@ describe("the trial on the live video", () => {
 		expect(cpu.closed()).toBe(false);
 		drive(f, 5, clock);
 		expect(cpu.calls).toHaveLength(PER + 5);
-		expect(gpu.calls).toHaveLength(PER);
+		expect(gpu.calls).toHaveLength(gpuCalls);
 		expect(f.trialResults.map((r) => r.delegate)).toEqual(["GPU", "CPU"]);
 		expect(f.trialResults[0].meanMs).toBeCloseTo(290, 6);
 	});
@@ -105,6 +108,32 @@ describe("the trial on the live video", () => {
 		expect(gpu.calls).toHaveLength(PER + 3);
 	});
 
+	test("a candidate far too slow to be kept stops its trial once its calls pass the time budget", () => {
+		// On a heavily throttled device the software GPU took about 3.3 s a call; the full trial (13 calls) spent
+		// about 43 s on it before the CPU (about 0.15 s a call) was even tried, and the face was analysed at
+		// 0.3 frames a second for the whole reading. The first call (shader compile, WASM warm-up) is not counted.
+		const clock = { t: 0 };
+		const gpu = fake("GPU", 3300, clock);
+		const cpu = fake("CPU", 150, clock);
+		const f = new TrialFaceFinder([gpu, cpu], { now: () => clock.t });
+		drive(f, 2 + PER, clock);
+		expect(gpu.calls.length).toBe(1 + Math.ceil(FINDER_TRIAL_BUDGET_MS / 3300));
+		expect(f.delegate).toBe("CPU");
+		expect(gpu.closed()).toBe(true);
+		expect(f.trialResults[0]).toEqual({ delegate: "GPU", meanMs: 3300 });
+	});
+
+	test("a fast candidate is timed for every call; the budget never cuts it short", () => {
+		const clock = { t: 0 };
+		const gpu = fake("GPU", 20, clock);
+		const cpu = fake("CPU", 60, clock);
+		const f = new TrialFaceFinder([gpu, cpu], { now: () => clock.t });
+		drive(f, 2 * PER, clock);
+		expect(gpu.calls.length).toBe(PER);
+		expect(cpu.calls.length).toBe(PER);
+		expect(f.delegate).toBe("GPU");
+	});
+
 	test("one candidate is simply used, with no trial", () => {
 		const clock = { t: 0 };
 		const cpu = fake("CPU", 60, clock);
diff --git a/packages/rppg-web/src/faceFinderTrial.ts b/packages/rppg-web/src/faceFinderTrial.ts
index 0946ec3..5cce4c3 100644
--- a/packages/rppg-web/src/faceFinderTrial.ts
+++ b/packages/rppg-web/src/faceFinderTrial.ts
@@ -35,6 +35,18 @@ export interface FinderCandidate {
 export const FINDER_TRIAL_WARMUP_CALLS = 3;
 export const FINDER_TRIAL_TIMED_CALLS = 10;
 
+/**
+ * A candidate's trial also ends once its calls after the first have taken this long in total, and its mean so
+ * far is its result. The first call is not counted: it pays shader compilation or WASM warm-up. Why: on a
+ * heavily throttled device (cgroup CPU limit, 2 cores at 40%) the software GPU took about 3.3 s a call, so the
+ * full trial spent about 43 s on it before trying the CPU (about 0.15 s a call), and the face was analysed at
+ * 0.3 frames a second for a whole 74 s reading against 3.9 with the trial switched off (a contributor-side
+ * browser measurement). 2 s still times every call of a candidate up to about 150 ms a call (12 calls), which
+ * covers a laptop CPU at its slowest measured (about 150 ms under the same limit), so only a candidate too
+ * slow to win is cut short.
+ */
+export const FINDER_TRIAL_BUDGET_MS = 2000;
+
 /**
  * How much faster a later candidate must be to displace an earlier one. CPU inference runs on the page's
  * own main thread and competes with every camera frame while the GPU mostly waits, so a CPU that wins a
@@ -99,7 +111,7 @@ export function faceRebuildReason(args: {
 export class TrialFaceFinder implements FaceLandmarkerLike {
 	private candidates: FinderCandidate[];
 	private current: FinderCandidate;
-	private trial: { index: number; calls: number; timed: number[] } | null;
+	private trial: { index: number; calls: number; timed: number[]; afterFirst: number[] } | null;
 	private readonly results: { delegate: FinderDelegate; meanMs: number }[] = [];
 	private readonly now: () => number;
 	private readonly rebuild?: (delegate: FinderDelegate) => Promise<FinderCandidate | null>;
@@ -126,7 +138,7 @@ export class TrialFaceFinder implements FaceLandmarkerLike {
 		if (!candidates.length) throw new Error("TrialFaceFinder needs at least one candidate");
 		this.candidates = [...candidates];
 		this.current = this.candidates[0];
-		this.trial = this.candidates.length > 1 ? { index: 0, calls: 0, timed: [] } : null;
+		this.trial = this.candidates.length > 1 ? { index: 0, calls: 0, timed: [], afterFirst: [] } : null;
 		this.now = opts.now ?? (() => (typeof performance !== "undefined" ? performance.now() : Date.now()));
 		this.rebuild = opts.rebuild;
 		this.onEvent = opts.onEvent;
@@ -193,8 +205,15 @@ export class TrialFaceFinder implements FaceLandmarkerLike {
 		const trial = this.trial!;
 		trial.calls += 1;
 		if (trial.calls > FINDER_TRIAL_WARMUP_CALLS) trial.timed.push(ms);
-		if (trial.timed.length < FINDER_TRIAL_TIMED_CALLS) return;
-		this.finishTrialCandidate(trial.timed.reduce((a, b) => a + b, 0) / trial.timed.length);
+		if (trial.calls > 1) trial.afterFirst.push(ms);
+		const mean = (xs: readonly number[]) => xs.reduce((a, b) => a + b, 0) / xs.length;
+		if (trial.timed.length >= FINDER_TRIAL_TIMED_CALLS) {
+			this.finishTrialCandidate(mean(trial.timed));
+			return;
+		}
+		// Too slow to be kept: stop paying for it (FINDER_TRIAL_BUDGET_MS).
+		if (trial.afterFirst.length && trial.afterFirst.reduce((a, b) => a + b, 0) >= FINDER_TRIAL_BUDGET_MS)
+			this.finishTrialCandidate(mean(trial.afterFirst));
 	}
 
 	/** Records the current candidate's mean call time (infinite: it failed) and moves the trial on. */
@@ -204,6 +223,7 @@ export class TrialFaceFinder implements FaceLandmarkerLike {
 		trial.index += 1;
 		trial.calls = 0;
 		trial.timed = [];
+		trial.afterFirst = [];
 		if (trial.index < this.candidates.length) {
 			this.current = this.candidates[trial.index];
 			return;
@@ -250,6 +270,7 @@ export class TrialFaceFinder implements FaceLandmarkerLike {
 					if (this.trial) {
 						this.trial.calls = 0;
 						this.trial.timed = [];
+						this.trial.afterFirst = [];
 					}
 				}
 				this.failedRebuilds = 0;
